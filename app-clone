#!/usr/bin/env bash
# app-clone — clone a macOS app with its own isolated profile (Work, Personal, Hobby, ...)
set -e

# ANSI styling
BOLD="\033[1m"
GREEN="\033[32m"
BLUE="\033[34m"
YELLOW="\033[33m"
RED="\033[31m"
RESET="\033[0m"

echo -e "${BOLD}${BLUE}=== macOS App Profile Cloner ===${RESET}\n"

# 1. Collect installed applications
APPS=()
while IFS= read -r app_path; do
  [[ -d "$app_path/Contents" ]] && APPS+=("$app_path")
done < <(find /Applications "$HOME/Applications" -maxdepth 2 -name "*.app" 2>/dev/null | sort)

if [ ${#APPS[@]} -eq 0 ]; then
  echo -e "${RED}Error: No .app bundles found in /Applications.${RESET}"
  exit 1
fi

# 2. Display paginated/numbered list
echo -e "${BOLD}Select an application to clone:${RESET}"
for i in "${!APPS[@]}"; do
  app_name="$(basename "${APPS[$i]}" .app)"
  printf "  ${GREEN}[%2d]${RESET} %s\n" "$((i + 1))" "$app_name"
done

echo ""
while true; do
  read -r -p "Enter number (1-${#APPS[@]}): " CHOICE
  if [[ "$CHOICE" =~ ^[0-9]+$ ]] && [ "$CHOICE" -ge 1 ] && [ "$CHOICE" -le "${#APPS[@]}" ]; then
    SELECTED_APP="${APPS[$((CHOICE - 1))]}"
    break
  else
    echo -e "${RED}Invalid selection. Please enter a valid number.${RESET}"
  fi
done

ORIGINAL_NAME="$(basename "$SELECTED_APP" .app)"
echo -e "\nSelected: ${BOLD}${GREEN}$ORIGINAL_NAME${RESET}"

# 3. Prompt for profile/clone identifier
read -r -p "Enter suffix/label for this clone (e.g. Work, CompanyB, Client): " CLONE_SUFFIX
CLONE_SUFFIX="${CLONE_SUFFIX// /_}" # Replace spaces with underscores

if [ -z "$CLONE_SUFFIX" ]; then
  CLONE_SUFFIX="Clone"
fi

CLONED_NAME="${ORIGINAL_NAME}-${CLONE_SUFFIX}"
DEST_APP="/Applications/${CLONED_NAME}.app"
PROFILE_DIR="$HOME/.app_profiles/${CLONED_NAME}"

if [ -d "$DEST_APP" ]; then
  echo -e "${YELLOW}Warning: $DEST_APP already exists.${RESET}"
  read -r -p "Overwrite existing clone? (y/N): " CONFIRM
  if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
    rm -rf "$DEST_APP"
  else
    echo "Aborted."
    exit 0
  fi
fi

# 4. Copy App Bundle
echo -e "\n${BLUE}[1/5] Copying bundle to $DEST_APP...${RESET}"
cp -a "$SELECTED_APP" "$DEST_APP"

# 5. Extract executable name and Info.plist
INFO_PLIST="$DEST_APP/Contents/Info.plist"
EXEC_NAME="$(/usr/libexec/PlistBuddy -c "Print :CFBundleExecutable" "$INFO_PLIST" 2>/dev/null || true)"
OLD_BUNDLE_ID="$(/usr/libexec/PlistBuddy -c "Print :CFBundleIdentifier" "$INFO_PLIST" 2>/dev/null || true)"

if [ -z "$EXEC_NAME" ]; then
  echo -e "${RED}Error: Could not locate CFBundleExecutable in Info.plist.${RESET}"
  rm -rf "$DEST_APP"
  exit 1
fi

# 6. Update Bundle Identifier and Display Name
echo -e "${BLUE}[2/5] Updating Bundle Identifier and display name...${RESET}"
NEW_BUNDLE_ID="${OLD_BUNDLE_ID}.${CLONE_SUFFIX}"
/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $NEW_BUNDLE_ID" "$INFO_PLIST" 2>/dev/null || \
  /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $NEW_BUNDLE_ID" "$INFO_PLIST"

/usr/libexec/PlistBuddy -c "Set :CFBundleName $CLONED_NAME" "$INFO_PLIST" 2>/dev/null || \
  /usr/libexec/PlistBuddy -c "Add :CFBundleName string $CLONED_NAME" "$INFO_PLIST"

# 7. Create launcher wrapper with isolated HOME
echo -e "${BLUE}[3/5] Injecting isolated HOME profile wrapper...${RESET}"
mkdir -p "$PROFILE_DIR"
MACOS_DIR="$DEST_APP/Contents/MacOS"

# Rename original binary
mv "$MACOS_DIR/$EXEC_NAME" "$MACOS_DIR/${EXEC_NAME}.real"

# Write the runtime environment wrapper
cat << EOF > "$MACOS_DIR/$EXEC_NAME"
#!/usr/bin/env bash
PROFILE_DIR="\$HOME/.app_profiles/${CLONED_NAME}"
mkdir -p "\$PROFILE_DIR"

# Redirect HOME so local config files stay completely isolated.
# Cocoa ignores HOME for NSHomeDirectory()/~/Library; CFFIXED_USER_HOME is what it honors.
export HOME="\$PROFILE_DIR"
export CFFIXED_USER_HOME="\$PROFILE_DIR"
exec "\$(dirname "\$0")/${EXEC_NAME}.real" "\$@"
EOF

chmod +x "$MACOS_DIR/$EXEC_NAME"

# 8. Clear quarantine and re-sign bundle ad-hoc
echo -e "${BLUE}[4/5] Removing quarantine and ad-hoc re-signing...${RESET}"
xattr -cr "$DEST_APP"
codesign --force --deep --sign - "$DEST_APP" 2>/dev/null || true

# 9. Register with macOS Launch Services
echo -e "${BLUE}[5/5] Registering with macOS Launch Services...${RESET}"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$DEST_APP" 2>/dev/null || true

echo -e "\n${BOLD}${GREEN}✔ Successfully created clone!${RESET}"
echo -e "• App Location: ${BOLD}$DEST_APP${RESET}"
echo -e "• Profile Data: ${BOLD}$PROFILE_DIR${RESET}\n"
